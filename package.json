{
  "name": "fflogs-finder",
  "version": "0.1.0",
  "private": true,
  "description": "FF14 固定募集メンバー比較ツール (FFLogs v2 API)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "measure:points": "node --env-file=.env scripts/measure-points.mts",
    "fetch:tiers": "node --env-file=.env scripts/dump-tiers.mts",
    "fetch:icons": "node --env-file=.env scripts/fetch-job-icons.mts",
    "e2e": "node scripts/e2e-check.mts",
    "screenshot": "node scripts/screenshot.mts",
    "fetch:worlds": "node --env-file=.env scripts/fetch-worlds.mts",
    "fetch:world-dc": "node scripts/fetch-world-dc.mts"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/redis": "^1.39.0",
    "clsx": "^2.1.1",
    "next": "^16.4.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "license": "MIT",
  "author": "samochang"
}
