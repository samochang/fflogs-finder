# FFLogs v2 API (required)
# https://www.fflogs.com/api/clients/ で発行したクライアント資格情報
FFL_CLIENT_ID=
FFL_CLIENT_SECRET=

# Upstash Redis (任意)
# 未設定の場合はプロセス内メモリストアにフォールバックする（開発用。Vercel では永続しない）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 対象 Tier を自動判定せず固定したい場合のみ（カンマ区切りの zoneID、新しい順）
# TIER_ZONE_IDS=73,68,62,54,49,44
# 取得対象 Tier 数（既定 6）
# TIER_COUNT=6
# refresh lock の保持秒数（既定 60）
# REFRESH_LOCK_TTL_SECONDS=60
